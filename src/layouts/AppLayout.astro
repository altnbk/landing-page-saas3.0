---
import { getUser } from '../lib/supabase';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Check authentication - redirect to login if not authenticated
const user = await getUser(Astro.cookies);

if (!user) {
  return Astro.redirect('/login');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <nav class="navbar">
      <div class="nav-container">
        <a href="/app" class="nav-brand">LP Generator</a>
        <div class="nav-links">
          <a href="/app">Create</a>
          <a href="/app/history">History</a>
          <span class="nav-user">{user.email}</span>
          <button id="logout-btn" class="btn btn-secondary btn-sm">Logout</button>
        </div>
      </div>
    </nav>
    <main class="main-content">
      <slot />
    </main>

    <script>
      document.getElementById('logout-btn')?.addEventListener('click', async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
          window.location.href = '/';
        } catch {
          window.location.href = '/';
        }
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    line-height: 1.6;
    color: #333;
    background-color: #f5f5f5;
    min-height: 100vh;
  }

  a {
    color: #5a67d8;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .navbar {
    background: white;
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .nav-brand {
    font-size: 1.25rem;
    font-weight: 700;
    color: #667eea;
  }

  .nav-brand:hover {
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-links a {
    color: #4a5568;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: #667eea;
    text-decoration: none;
  }

  .nav-user {
    color: #718096;
    font-size: 0.875rem;
  }

  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 20px;
  }

  .btn {
    display: inline-block;
    padding: 12px 24px;
    font-size: 1rem;
    font-weight: 500;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.875rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    text-decoration: none;
  }

  .btn-secondary {
    background: #e2e8f0;
    color: #4a5568;
  }

  .btn-secondary:hover:not(:disabled) {
    background: #cbd5e0;
    text-decoration: none;
  }

  .btn-danger {
    background: #e53e3e;
    color: white;
  }

  .btn-danger:hover:not(:disabled) {
    background: #c53030;
    text-decoration: none;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: #4a5568;
  }

  .form-input {
    width: 100%;
    padding: 12px;
    font-size: 1rem;
    border: 2px solid #e2e8f0;
    border-radius: 8px;
    transition: border-color 0.2s;
    font-family: inherit;
  }

  .form-input:focus {
    outline: none;
    border-color: #667eea;
  }

  .form-hint {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.75rem;
    color: #718096;
  }

  .card {
    background: white;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 1rem;
  }

  .alert-error {
    background: #fed7d7;
    color: #c53030;
    border: 1px solid #feb2b2;
  }

  .alert-success {
    background: #c6f6d5;
    color: #276749;
    border: 1px solid #9ae6b4;
  }

  .alert a {
    color: inherit;
    font-weight: 600;
  }
</style>
